meta {
  name: 11 Wrong-total status
  type: http
  seq: 11
}

get {
  url: {{host}}/v1alpha1/documents/{{wrong_id}}
  body: none
  auth: none
}

script:pre-request {
  // Processing is asynchronous (parse, classify, LLM). Wait until the document settles.
  const axios = require("axios");
  const url = bru.interpolate("{{host}}/v1alpha1/documents/{{wrong_id}}");
  for (let i = 0; i < 90; i++) {
    const r = await axios.get(url, { validateStatus: () => true });
    if (r.status === 200 && r.data.status !== "processing") break;
    await bru.sleep(4000);
  }
}

tests {
