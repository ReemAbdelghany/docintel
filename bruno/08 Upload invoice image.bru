meta {
  name: 08 Upload invoice image
  type: http
  seq: 8
}

post {
  url: {{host}}/v1alpha1/cases/{{case_id}}/documents
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file(../assets/Examples/invoice_clean.png)
}

script:post-response {
  bru.setVar("image_id", res.body.document_id);
}

tests {
  test("accepted for processing", function () {
    expect(res.status).to.equal(202);
    expect(res.body.status).to.equal("processing");
  });
}

docs {
  An image of an invoice: read with OCR, then handled like a PDF.
}
