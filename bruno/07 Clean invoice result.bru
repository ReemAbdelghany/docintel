meta {
  name: 07 Clean invoice result
  type: http
  seq: 7
}

get {
  url: {{host}}/v1alpha1/documents/{{clean_id}}/result
  body: none
  auth: none
}

tests {
  test("typed facts with page-level evidence", function () {
    expect(res.status).to.equal(200);
    expect(res.body.facts.invoice_number).to.be.a("string");
    expect(res.body.facts.total.currency).to.equal("EGP");
    const fields = res.body.evidence.map((e) => e.field);
    ["vendor_name", "invoice_number", "issue_date", "total"].forEach((f) =>
      expect(fields).to.include(f)
    );
  });
}

docs {
  Extracted facts, the evidence snippets, and the model and prompt version that produced them.
}
