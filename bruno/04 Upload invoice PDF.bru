meta {
  name: 04 Upload invoice PDF
  type: http
  seq: 4
}

post {
  url: {{host}}/v1alpha1/cases/{{case_id}}/documents
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file(../assets/Examples/invoice_clean.pdf)
}

script:post-response {
  bru.setVar("invoice_id", res.body.document_id);
}

tests {
  test("accepted for processing", function () {
    expect(res.status).to.equal(202);
    expect(res.body.status).to.equal("processing");
  });
}

docs {
  Step 2. Returns 202 at once; the file is parsed, classified, extracted and decided in the background.
}
