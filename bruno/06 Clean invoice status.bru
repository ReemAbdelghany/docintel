meta {
  name: 06 Clean invoice status
  type: http
  seq: 6
}

get {
  url: {{host}}/v1alpha1/documents/{{clean_id}}
  body: none
  auth: none
}

script:pre-request {
  // The pipeline is asynchronous (parse, classify, LLM). Wait until it settles.
  const axios = require("axios");
  const url = bru.interpolate("{{host}}/v1alpha1/documents/{{clean_id}}");
  const settled = ["accepted", "needs_review", "failed"];
  for (let i = 0; i < 90; i++) {
    const r = await axios.get(url, { validateStatus: () => true });
    if (r.status === 200 && settled.includes(r.data.status)) break;
    await bru.sleep(4000);
  }
}

tests {
  test("clean invoice is classified and accepted", function () {
    expect(res.status).to.equal(200);
    expect(res.body.document_type).to.equal("invoice");
    expect(res.body.status).to.equal("accepted");
    expect(res.body.findings.filter((f) => f.severity === "blocking")).to.have.length(0);
  });
}

docs {
  Waits (up to ~6 minutes) until processing settles, so there is nothing to re-send.
}
