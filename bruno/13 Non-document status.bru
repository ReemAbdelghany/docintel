meta {
  name: 13 Non-document status
  type: http
  seq: 13
}

get {
  url: {{host}}/v1alpha1/documents/{{bad_id}}
  body: none
  auth: none
}

script:pre-request {
  // Processing is asynchronous (parse, classify, LLM). Wait until the document settles.
  const axios = require("axios");
  const url = bru.interpolate("{{host}}/v1alpha1/documents/{{bad_id}}");
  for (let i = 0; i < 90; i++) {
    const r = await axios.get(url, { validateStatus: () => true });
    if (r.status === 200 && r.data.status !== "processing") break;
    await bru.sleep(4000);
  }
}

tests {
  test("decision is needs_review", function () {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("needs_review");
    expect(res.body.reason).to.contain("parsing failed");
  });
}

docs {
  When the system cannot process a file with confidence, it is routed to manual review.
}
