meta {
  name: 05 Upload same file again
  type: http
  seq: 5
}

post {
  url: {{host}}/v1alpha1/cases/{{case_id}}/documents
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file(../assets/Examples/invoice_clean.pdf)
}

tests {
  test("duplicate upload returns the existing document", function () {
    expect(res.status).to.equal(202);
    expect(res.body.duplicate).to.equal(true);
    expect(res.body.document_id).to.equal(bru.getVar("clean_id"));
  });
}

docs {
  Idempotent intake: same bytes in the same case never create a second document.
}
